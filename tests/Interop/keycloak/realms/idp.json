{
  "realm": "idp",
  "enabled": true,
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Test",
      "realmRoles": ["default-roles-idp"],
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "http://localhost:8180/realms/sp",
      "protocol": "saml",
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:8180/realms/sp/broker/idp/endpoint"],
      "attributes": {
        "saml.allow.ecp.flow": "false",
        "saml.authnstatement": "true",
        "saml.client.signature": "false",
        "saml.force.post.binding": "true",
        "saml.server.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_force_name_id_format": "false",
        "saml_name_id_format": "username",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml_single_logout_service_url_post": "http://localhost:8180/realms/sp/broker/idp/endpoint"
      }
    }
  ]
}
